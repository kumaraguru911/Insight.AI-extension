{
  "manifest_version": 3,
  "name": "Insight.AI - Smart Research Companion",
  "version": "1.0",
  "description": "InsightAI Chrome Extension - AI explanations, summaries and translations using Gemini API",
  "icons": {
    "48": "icons/icon48.png"
  },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/tooltip_content_script.js"],
      "css": ["src/styles/tooltip.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Insight.AI"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/styles/history.css",
        "src/content/history_content_script.js",
        "icons/icon48.png",
        "src/styles/tooltip.css",
        "src/extraction/extraction.css",
        "src/extraction/pdf-lib.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "open-extraction": {
      "suggested_key": "Ctrl+Shift+E",
      "description": "Open Extract & Summarize Tool"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline';"
  }
}
